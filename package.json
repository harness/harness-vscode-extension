{
  "name": "harness-vscode",
  "displayName": "Harness",
  "description": "Monitor Harness pipelines, view logs, and manage approvals directly in VS Code. Real-time CI/CD visibility without context switching.",
  "version": "0.1.10",
  "publisher": "harness",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Testing"
  ],
  "keywords": [
    "harness",
    "ci/cd",
    "pipelines",
    "devops",
    "continuous integration",
    "continuous deployment",
    "logs",
    "testing",
    "approvals",
    "monitoring"
  ],
  "icon": "icons/harness-icon.png",
  "galleryBanner": {
    "color": "#00ADE4",
    "theme": "dark"
  },
  "license": "MIT",
  "qna": "https://github.com/harness/harness-vscode-extension/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/harness/harness-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/harness/harness-vscode-extension/issues"
  },
  "homepage": "https://github.com/harness/harness-vscode-extension#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harness",
          "title": "Harness",
          "icon": "icons/harness-icon.png"
        }
      ]
    },
    "views": {
      "harness": [
        {
          "type": "webview",
          "id": "harness.sidebar",
          "name": "Pipeline"
        }
      ]
    },
    "commands": [
      {
        "command": "harness.configureApiKey",
        "title": "Harness: Configure API Key"
      },
      {
        "command": "harness.resetConfiguration",
        "title": "Harness: Reset Auth Configuration"
      },
      {
        "command": "harness.selectProject",
        "title": "Harness: Select Org & Project"
      },
      {
        "command": "harness.switchProject",
        "title": "Harness: Switch Project (This Workspace)"
      },
      {
        "command": "harness.refreshNow",
        "title": "Harness: Refresh Pipeline Status"
      },
      {
        "command": "harness.openInHarness",
        "title": "Harness: Open Execution in Browser"
      },
      {
        "command": "harness.rerunStage",
        "title": "Harness: Re-run Failed Stage"
      },
      {
        "command": "harness.rerunTest",
        "title": "Harness: Re-run Test via Harness"
      },
      {
        "command": "harness.exportLastExecution",
        "title": "Harness: Export Current Execution to JSON"
      },
      {
        "command": "harness.showDebugOutput",
        "title": "Harness: Show Debug Output"
      },
      {
        "command": "harness.debugFmeFlags",
        "title": "Harness: Debug FME Flags"
      },
      {
        "command": "harness.openIntelligenceChat",
        "title": "Harness: Open AI Chat",
        "icon": {
          "light": "icons/harness-intelligence-light.svg",
          "dark": "icons/harness-intelligence-dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "harness.openIntelligenceChat",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "harness.openIntelligenceChat",
          "group": "navigation@1",
          "when": "harness.aidaEnabled"
        }
      ],
      "modalEditor/editorTitle": [
        {
          "command": "harness.openIntelligenceChat",
          "group": "navigation@1",
          "when": "harness.aidaEnabled"
        }
      ]
    },
    "languages": [
      {
        "id": "harness-log",
        "aliases": [
          "Harness Log"
        ],
        "extensions": [
          ".harness-log"
        ]
      }
    ],
    "grammars": [
      {
        "language": "harness-log",
        "scopeName": "text.harness-log",
        "path": "./syntaxes/log.tmLanguage.json"
      }
    ],
    "configuration": [
      {
        "title": "Harness",
        "order": 1,
        "properties": {
          "harness.baseUrl": {
            "type": "string",
            "default": "https://app.harness.io",
            "description": "Harness instance URL. Change for on-prem deployments."
          },
          "harness.accountIdentifier": {
            "type": "string",
            "default": "",
            "description": "Harness account ID (Account Settings → Overview)."
          },
          "harness.authSource": {
            "type": "string",
            "enum": [
              "pat",
              "env"
            ],
            "enumDescriptions": [
              "Personal Access Token stored in secret storage",
              "Environment variables (HARNESS_API_KEY, HARNESS_BASE_URL, HARNESS_ACCOUNT_ID)"
            ],
            "default": "pat",
            "description": "Authentication method. Set automatically during onboarding."
          },
          "harness.orgIdentifier": {
            "type": "string",
            "default": "default",
            "description": "Default Harness organization identifier."
          },
          "harness.projectIdentifier": {
            "type": "string",
            "default": "",
            "description": "Default Harness project identifier."
          },
          "harness.pollingIntervalSeconds": {
            "type": "number",
            "default": 10,
            "minimum": 5,
            "maximum": 120,
            "description": "Poll interval in seconds during active pipeline runs."
          },
          "harness.diffAwareSTO": {
            "type": "boolean",
            "default": true,
            "description": "Limit STO annotations to files changed in the current diff only."
          },
          "harness.defaultView": {
            "type": "string",
            "enum": [
              "thisCommit",
              "allExecutions"
            ],
            "enumDescriptions": [
              "Show the pipeline for your current HEAD commit (default)",
              "Show the full project execution history list"
            ],
            "default": "thisCommit",
            "description": "Which view opens by default when the Harness panel loads."
          },
          "harness.fmeSdkKey": {
            "type": "string",
            "default": "",
            "description": "Harness FME (Feature Management & Experimentation) SDK key. Get it from: FME → Admin → SDK Keys → Client-side"
          },
          "harness.logLevel": {
            "type": "string",
            "enum": [
              "off",
              "error",
              "warn",
              "info",
              "debug"
            ],
            "enumDescriptions": [
              "No logs (production mode)",
              "Errors only",
              "Errors and warnings",
              "Errors, warnings, and info messages (recommended)",
              "All logs including debug traces (development mode)"
            ],
            "default": "info",
            "description": "Controls console output verbosity. Use 'debug' for troubleshooting, 'info' for normal operation, 'error' for production."
          }
        }
      },
      {
        "title": "Proxy Settings",
        "order": 2,
        "properties": {
          "harness.proxy": {
            "type": "string",
            "default": "",
            "order": 1,
            "scope": "machine",
            "markdownDescription": "HTTP(S) proxy URL used for all extension network requests, for example `http://proxy.example.com:8080`. It must start with `http://` or `https://`.\n\nLeave empty to use the standard `https_proxy`, `HTTPS_PROXY`, `http_proxy` or `HTTP_PROXY` environment variables.\n\n**Good to know**\n\n- `NO_PROXY` is honored only for environment-variable proxies, not for feature-flag traffic.\n- VS Code's own `http.proxy` and `http.proxySupport` settings also apply and may take precedence on recent VS Code versions.\n- Feature-flag traffic picks up changes after **Developer: Reload Window**. Environment variable changes require restarting VS Code.\n- This value is stored in plain text. If your proxy requires credentials, use environment variables instead."
          },
          "harness.caBundle": {
            "type": "string",
            "default": "",
            "order": 2,
            "scope": "machine",
            "markdownDescription": "Absolute path to a PEM file with extra certificate authorities, for private or TLS-inspecting proxies. For example `/etc/ssl/certs/corp-ca.pem`.\n\nThe certificates in this file are added to the Node.js and operating system root certificates, which are always trusted. Feature-flag traffic picks up changes after **Developer: Reload Window**."
          }
        }
      },
      {
        "title": "AI Tools",
        "order": 3,
        "properties": {
          "harness.ai.preferredExternalTool": {
            "type": "string",
            "enum": [
              "auto",
              "claudecode-cli",
              "claudecode-ext",
              "cursor",
              "copilot",
              "kiro"
            ],
            "enumDescriptions": [
              "Use the first detected tool",
              "Claude Code CLI in the integrated terminal",
              "Claude Code extension",
              "Cursor",
              "GitHub Copilot",
              "Kiro"
            ],
            "default": "auto",
            "description": "Which external AI tool to use when the destination is External. Harness AI is selected with Default Destination. The sidebar picker writes this setting."
          },
          "harness.ai.defaultDestination": {
            "type": "string",
            "enum": [
              "harness",
              "external"
            ],
            "enumDescriptions": [
              "Ask Harness AI in the extension",
              "Send to the selected external tool"
            ],
            "default": "harness",
            "description": "Where the sidebar composer sends a question. Harness sends to Harness AI. External sends to the preferred external tool."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "harness.gettingStarted",
        "title": "Get Started with Harness",
        "description": "Connect to your Harness account and watch your pipeline live.",
        "steps": [
          {
            "id": "harness.configureApiKey",
            "title": "Configure your API key",
            "description": "Enter your Harness API key to authenticate.\n[Configure API Key](command:harness.configureApiKey)",
            "completionEvents": [
              "onCommand:harness.configureApiKey"
            ]
          },
          {
            "id": "harness.openSidebar",
            "title": "Push a commit and watch your pipeline",
            "description": "Open the Harness panel in the activity bar to see live pipeline status.\n[Open Harness Panel](command:harness.sidebar.focus)",
            "completionEvents": [
              "onView:harness.sidebar"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@splitsoftware/splitio": "^11.11.1",
    "https-proxy-agent": "^7.0.6",
    "marked": "^12.0.2",
    "undici": "^6.21.1"
  }
}
