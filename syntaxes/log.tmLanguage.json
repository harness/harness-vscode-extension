{
  "name": "Harness Log",
  "scopeName": "text.harness-log",
  "patterns": [
    {
      "match": "^#.*$",
      "name": "comment.line"
    },
    {
      "match": "^(?:(\\d{2}:\\d{2}:\\d{2}) )?(ERROR)\\b",
      "captures": {
        "1": { "name": "string" },
        "2": { "name": "markup.deleted" }
      }
    },
    {
      "match": "^(?:(\\d{2}:\\d{2}:\\d{2}) )?(WARN)\\b",
      "captures": {
        "1": { "name": "string" },
        "2": { "name": "markup.changed" }
      }
    },
    {
      "match": "^(?:(\\d{2}:\\d{2}:\\d{2}) )?(SUCCESS)\\b",
      "captures": {
        "1": { "name": "string" },
        "2": { "name": "markup.inserted" }
      }
    },
    {
      "match": "^(?:(\\d{2}:\\d{2}:\\d{2}) )?(INFO)\\b",
      "captures": {
        "1": { "name": "string" },
        "2": { "name": "comment" }
      }
    },
    {
      "match": "^(?:(\\d{2}:\\d{2}:\\d{2}) )?(DEBUG)\\b",
      "captures": {
        "1": { "name": "string" },
        "2": { "name": "comment.block" }
      }
    },
    {
      "match": "^\\d{2}:\\d{2}:\\d{2}\\b",
      "name": "string"
    }
  ]
}
